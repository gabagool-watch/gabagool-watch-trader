# Backend (Lovable Cloud)
BACKEND_URL=your_backend_url
RUNNER_SHARED_SECRET=your_shared_secret

# Supabase (for position sync to database)
SUPABASE_URL=https://iuzpdjplasndyvbzhlzd.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Polymarket API credentials (CLOB trading)
POLYMARKET_API_KEY=your_api_key
POLYMARKET_API_SECRET=your_api_secret
POLYMARKET_PASSPHRASE=your_passphrase
POLYMARKET_PRIVATE_KEY=your_wallet_private_key
POLYMARKET_ADDRESS=your_wallet_address

# Polymarket Builder API credentials (for gasless redemptions on Magic/Email wallets)
# Get these from https://docs.polymarket.com/#builder-api
POLY_BUILDER_API_KEY=your_builder_api_key
POLY_BUILDER_API_SECRET=your_builder_api_secret
POLY_BUILDER_PASSPHRASE=your_builder_passphrase

# Wallet type (optional): 0=EOA, 1=Magic/Email, 2=Gnosis Safe
POLYMARKET_SIGNATURE_TYPE=1

# Trading settings (optional)
TRADE_ASSETS=BTC
MAX_NOTIONAL_PER_TRADE=5
OPENING_MAX_PRICE=0.52
